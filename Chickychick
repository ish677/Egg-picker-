<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Egg Picker</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display&family=Nunito+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito Sans', sans-serif;
            background-color: #fdf6f0; /* Soft cream background */
            color: #444; /* Neutral dark gray text */
            margin: 0;
            padding: 0;
            text-align: center;
            background-image: url('https://www.transparenttextures.com/patterns/cotton-squares.png');
            background-size: cover;
        }
        .container {
            margin-top: 60px;
            padding: 20px;
        }
        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3em;
            color: #d85b5b; /* Elegant soft pink */
            margin-bottom: 20px;
            letter-spacing: 1px;
        }
        h2 {
            font-size: 2em;
            color: #6b8e23; /* Olive green for a farm-like vibe */
            margin-bottom: 20px;
        }
        .message {
            font-size: 1.5em;
            color: #f1c40f; /* Warm yellow text */
            margin-top: 30px;
        }
        button {
            font-size: 1.5em;
            padding: 12px 30px;
            margin: 20px;
            border: none;
            cursor: pointer;
            border-radius: 20px;
            background-color: #ffb3b3; /* Soft pink */
            color: #fff;
            transition: 0.3s;
        }
        button:hover {
            background-color: #d85b5b; /* Slightly darker pink on hover */
        }
        .balot {
            background-color: #ffb3b3;
        }
        .penoy {
            background-color: #f1c40f; /* Light yellow for Penoy */
        }
        img {
            width: 120px;
            height: 120px;
            margin-top: 20px;
            border-radius: 50%;
            border: 4px solid #fff; /* Soft white border around the images */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .confetti {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: -1;
        }
        .farm-elements {
            margin-top: 30px;
            font-size: 1.2em;
            color: #d85b5b;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Welcome Page -->
        <div id="welcomePage">
            <h1>Hi 🤗 Welcome to the Farm</h1>
            <button onclick="goToChoice()">Next</button>
        </div>

        <!-- Choice Page -->
        <div id="choicePage" style="display: none;">
            <h2>Choose your fighter 🐣</h2>
            <button class="balot" onclick="chooseBalot()">Balot</button>
            <button class="penoy" onclick="choosePenoy()">Penoy</button>
        </div>

        <!-- Thank You Page -->
        <div id="thankYouPage" style="display: none;">
            <h1 class="message" id="thankYouMessage">Thank you for choosing, meet me at the right place, and next time choose me!</h1>
            <img id="finalImage" src="" alt="Thank you image">
            <div class="farm-elements">🐥 Chicks and eggs are waiting for you!</div>
        </div>
    </div>

    <!-- Confetti Effect -->
    <div class="confetti" id="confetti"></div>

    <script>
        function goToChoice() {
            document.getElementById('welcomePage').style.display = 'none';
            document.getElementById('choicePage').style.display = 'block';
        }

        function chooseBalot() {
            document.getElementById('choicePage').style.display = 'none';
            document.getElementById('thankYouPage').style.display = 'block';
            document.getElementById('thankYouMessage').textContent = 'Thank you for choosing Balot, meet me at the right place, and next time choose me!';
            document.getElementById('finalImage').src = 'https://www.example.com/chick-image.jpg'; // Replace with your chick image URL
            triggerConfetti();
        }

        function choosePenoy() {
            document.getElementById('choicePage').style.display = 'none';
            document.getElementById('thankYouPage').style.display = 'block';
            document.getElementById('thankYouMessage').textContent = 'Thank you for choosing Penoy, meet me at the right place, and next time choose me!';
            document.getElementById('finalImage').src = 'https://www.example.com/egg-image.jpg'; // Replace with your egg image URL
            triggerConfetti();
        }

        function triggerConfetti() {
            const confettiElement = document.getElementById('confetti');
            confettiElement.innerHTML = '<canvas id="confettiCanvas"></canvas>';

            const canvas = document.getElementById('confettiCanvas');
            const ctx = canvas.getContext('2d');
            const width = window.innerWidth;
            const height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;

            const colors = ['#ff4d88', '#ffcc00', '#66ccff', '#ff6666', '#f5a623'];

            function createConfetti() {
                const x = Math.random() * width;
                const y = Math.random() * height;
                const color = colors[Math.floor(Math.random() * colors.length)];
                ctx.fillStyle = color;
                ctx.beginPath();
                ctx.arc(x, y, 5 + Math.random() * 5, 0, Math.PI * 2);
                ctx.fill();
            }

            setInterval(createConfetti, 20);
        }
    </script>
</body>
</html>
